<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockApplication.Views.ChangePasswordPage"
             Title="Change Password">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Margin="0,20,0,20">
            <Label Text="Change Your Password" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#3F51B5"
                   HorizontalOptions="Center" />
            <Label Text="Update your account password for better security" 
                   FontSize="14" 
                   TextColor="#757575"
                   HorizontalOptions="Center" 
                   Margin="0,10,0,0" />
        </VerticalStackLayout>
        
        <!-- Password Form -->
        <VerticalStackLayout Grid.Row="1" 
                             VerticalOptions="Center" 
                             Spacing="20">
            <Frame Padding="20" 
                   CornerRadius="10" 
                   BorderColor="Transparent" 
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Current Password -->
                    <VerticalStackLayout>
                        <Label Text="Current Password" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="CurrentPasswordEntry" 
                                   Placeholder="Enter your current password"
                                   PlaceholderColor="#BDBDBD"
                                   IsPassword="True"
                                   Text="{Binding CurrentPassword}"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- New Password -->
                    <VerticalStackLayout>
                        <Label Text="New Password" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="NewPasswordEntry" 
                                   Placeholder="Enter new password"
                                   PlaceholderColor="#BDBDBD"
                                   IsPassword="True"
                                   Text="{Binding NewPassword}"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Confirm New Password -->
                    <VerticalStackLayout>
                        <Label Text="Confirm New Password" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="ConfirmPasswordEntry" 
                                   Placeholder="Confirm new password"
                                   PlaceholderColor="#BDBDBD"
                                   IsPassword="True"
                                   Text="{Binding ConfirmPassword}"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Error Message -->
                    <Label x:Name="ErrorLabel" 
                           Text="{Binding ErrorMessage}" 
                           TextColor="#F44336"
                           IsVisible="{Binding HasError}"
                           HorizontalOptions="Center"/>
                    
                    <!-- Password requirements info -->
                    <Frame Padding="10" 
                           CornerRadius="5" 
                           BackgroundColor="#F5F5F5" 
                           BorderColor="Transparent"
                           HasShadow="False">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Password Requirements:" 
                                   FontSize="12" 
                                   TextColor="#757575" 
                                   FontAttributes="Bold"/>
                            <Label Text="• At least 8 characters long" 
                                   FontSize="12" 
                                   TextColor="#757575"/>
                            <Label Text="• Include a mix of letters, numbers, and symbols" 
                                   FontSize="12" 
                                   TextColor="#757575"/>
                        </VerticalStackLayout>
                    </Frame>
                    
                    <!-- Update Password Button -->
                    <Button Text="Update Password"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="10"
                            Command="{Binding ChangePasswordCommand}"
                            x:Name="UpdatePasswordButton"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
        
        <!-- Cancel Button -->
        <Button Grid.Row="2" 
                Text="Cancel" 
                BackgroundColor="Transparent" 
                TextColor="#757575"
                CornerRadius="0"
                BorderWidth="0"
                Margin="0,10,0,20"
                HorizontalOptions="Center"
                Clicked="OnCancelClicked"/>
    </Grid>
</ContentPage>