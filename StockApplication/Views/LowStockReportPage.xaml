<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockApplication.Views.Reports.LowStockReportPage"
             Title="Low Stock Report">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="15">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Margin="0,10,0,20">
            <Label Text="Low Stock Report" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#F44336"/>
            
            <!-- Threshold Selector -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,15,0,0">
                <Label Grid.Column="0" 
                       Text="Threshold:" 
                       VerticalOptions="Center"/>
                <Slider Grid.Column="1" 
                        x:Name="ThresholdSlider" 
                        Minimum="1" 
                        Maximum="50" 
                        Value="10"/>
                <Label Grid.Column="2" 
                       x:Name="ThresholdValueLabel" 
                       Text="10" 
                       VerticalOptions="Center"/>
            </Grid>
            
            <Button Text="Apply" 
                    BackgroundColor="#F44336"
                    TextColor="White"
                    CornerRadius="5"
                    HorizontalOptions="End"
                    Margin="0,10,0,0"
                    x:Name="ApplyButton"/>
        </VerticalStackLayout>
        
        <!-- Summary Card -->
        <Frame Grid.Row="1" 
               BorderColor="Transparent"
               BackgroundColor="#FFEBEE"
               CornerRadius="10"
               Padding="15"
               Margin="0,0,0,20">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="Items Below Threshold" 
                           FontSize="14" 
                           TextColor="#D32F2F"
                           HorizontalOptions="Center"/>
                    <Label x:Name="LowStockCountLabel" 
                           Text="0" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           TextColor="#D32F2F"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
                
                <BoxView WidthRequest="1" 
                         Color="#E0E0E0" 
                         VerticalOptions="Center"
                         HeightRequest="40"/>
                
                <VerticalStackLayout HorizontalOptions="Center">
                    <Label Text="Percentage of Inventory" 
                           FontSize="14" 
                           TextColor="#D32F2F"
                           HorizontalOptions="Center"/>
                    <Label x:Name="PercentageLabel" 
                           Text="0%" 
                           FontSize="24" 
                           FontAttributes="Bold"
                           TextColor="#D32F2F"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Frame>
        
        <!-- Data Table -->
        <Frame Grid.Row="2" 
               BorderColor="#E0E0E0"
               CornerRadius="10"
               Padding="0"
               Margin="0,0,0,20">
            <CollectionView x:Name="LowStockItemsCollection">
                <CollectionView.Header>
                    <Grid ColumnDefinitions="*, *, *, *" BackgroundColor="#F5F5F5" Padding="15">
                        <Label Grid.Column="0" Text="Item Name" FontAttributes="Bold"/>
                        <Label Grid.Column="1" Text="Current Qty" FontAttributes="Bold"/>
                        <Label Grid.Column="2" Text="Unit" FontAttributes="Bold"/>
                        <Label Grid.Column="3" Text="Supplier" FontAttributes="Bold"/>
                    </Grid>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*, *, *, *" Padding="15">
                            <Label Grid.Column="0" Text="{Binding Stock_Name}"/>
                            <Label Grid.Column="1" 
                                   Text="{Binding Quantity}" 
                                   TextColor="#D32F2F" 
                                   FontAttributes="Bold"/>
                            <Label Grid.Column="2" Text="{Binding Unit}"/>
                            <Label Grid.Column="3" Text="{Binding SupplierName}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                        <Label Text="No items below threshold" 
                               TextColor="#757575" 
                               HorizontalOptions="Center"/>
                        <Label Text="All stock items are above the minimum threshold" 
                               TextColor="#BDBDBD" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Frame>
        
        <!-- Export Options -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="15">
            <Button Grid.Column="0"
                    Text="Export as CSV"
                    BackgroundColor="#795548"
                    TextColor="White"
                    CornerRadius="5"
                    x:Name="ExportCsvButton"/>
            
            <Button Grid.Column="1"
                    Text="Export as PDF"
                    BackgroundColor="#E91E63"
                    TextColor="White"
                    CornerRadius="5"
                    x:Name="ExportPdfButton"/>
        </Grid>
    </Grid>
</ContentPage>