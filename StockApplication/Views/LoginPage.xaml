<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockApplication.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Title="Login">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Margin="0,40,0,0">
            <Image Source="logo.png" 
                   HeightRequest="120" 
                   WidthRequest="120"
                   HorizontalOptions="Center" />
            <Label Text="Stock Management System" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#3F51B5"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0" />
        </VerticalStackLayout>
        
        <!-- Login Form -->
        <VerticalStackLayout Grid.Row="1" 
                             VerticalOptions="Center" 
                             Spacing="20">
            <Frame Padding="20" 
                   CornerRadius="10" 
                   BorderColor="Transparent" 
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Username -->
                    <VerticalStackLayout>
                        <Label Text="Username" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="UsernameEntry" 
                                   Placeholder="Enter username"
                                   PlaceholderColor="#BDBDBD"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Password -->
                    <VerticalStackLayout>
                        <Label Text="Password" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="PasswordEntry" 
                                   Placeholder="Enter password"
                                   PlaceholderColor="#BDBDBD"
                                   IsPassword="True"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Error Message -->
                    <Label x:Name="ErrorLabel" 
                           Text="" 
                           TextColor="#F44336"
                           IsVisible="False"
                           HorizontalOptions="Center"/>
                    
                    <!-- Login Button -->
                    <Button Text="Login"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="10"
                            x:Name="LoginButton"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
        
        <!-- Footer -->
        <VerticalStackLayout Grid.Row="2" 
                             VerticalOptions="End" 
                             HorizontalOptions="Center"
                             Margin="0,0,0,20">
            <Label Text="© 2025 Restaurant POS System" 
                   FontSize="12" 
                   TextColor="#9E9E9E"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>