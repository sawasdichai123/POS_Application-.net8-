<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockApplication.Views.SupplierListPage"
             Title="Suppliers">
    
    <Grid RowDefinitions="Auto,*,Auto" Padding="15">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,10,0,20">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Suppliers" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#3F51B5"/>
                <Label Text="Manage your suppliers" 
                       FontSize="14" 
                       TextColor="#757575"
                       Margin="0,5,0,0"/>
            </VerticalStackLayout>
            
            <Button Grid.Column="1"
                    Text="+ Add Supplier"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    x:Name="AddSupplierButton"/>
        </Grid>
        
        <!-- Search Bar -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Frame Padding="15,0"
                   CornerRadius="10"
                   BorderColor="#E0E0E0"
                   HasShadow="False"
                   Margin="0,0,0,15">
                <Entry Placeholder="Search suppliers..."
                       PlaceholderColor="#9E9E9E"
                       x:Name="SearchEntry"
                       VerticalOptions="Center"
                       ClearButtonVisibility="WhileEditing"/>
            </Frame>
            
            <!-- Supplier List -->
            <RefreshView Grid.Row="1" x:Name="SupplierRefreshView">
                <CollectionView x:Name="SupplierCollectionView"
                               SelectionMode="Single">
                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="empty_contacts.png" 
                                   HeightRequest="100" 
                                   WidthRequest="100"
                                   Opacity="0.5"
                                   Margin="0,0,0,20"/>
                            <Label Text="No suppliers found" 
                                   FontSize="18" 
                                   TextColor="#9E9E9E"
                                   HorizontalOptions="Center"/>
                            <Label Text="Add your first supplier to get started" 
                                   FontSize="14" 
                                   TextColor="#BDBDBD"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5,0,10"
                                   Padding="15"
                                   CornerRadius="10"
                                   BorderColor="Transparent"
                                   HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <!-- Supplier Name -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Sup_name}" 
                                           FontSize="18" 
                                           FontAttributes="Bold"
                                           TextColor="#212121"/>
                                    
                                    <!-- Contact Info -->
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                                       Margin="0,10,0,10">
                                        <!-- Phone -->
                                        <HorizontalStackLayout>
                                            <Label Text="Phone: " 
                                                   FontSize="14"
                                                   TextColor="#9E9E9E"/>
                                            <Label Text="{Binding Sup_Phone}" 
                                                   FontSize="14"
                                                   TextColor="#616161"/>
                                        </HorizontalStackLayout>
                                        
                                        <!-- Email -->
                                        <HorizontalStackLayout Margin="0,5,0,0">
                                            <Label Text="Email: " 
                                                   FontSize="14"
                                                   TextColor="#9E9E9E"/>
                                            <Label Text="{Binding Sup_Email}" 
                                                   FontSize="14"
                                                   TextColor="#616161"/>
                                        </HorizontalStackLayout>
                                        
                                        <!-- Address -->
                                        <HorizontalStackLayout Margin="0,5,0,0">
                                            <Label Text="Address: " 
                                                   FontSize="14"
                                                   TextColor="#9E9E9E"/>
                                            <Label Text="{Binding Sup_Address}" 
                                                   FontSize="14"
                                                   TextColor="#616161"/>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    
                                    <!-- Action Buttons -->
                                    <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                       Spacing="10"
                                                       VerticalOptions="Center">
                                        <Button Text="Edit"
                                                FontSize="12"
                                                BackgroundColor="#2196F3"
                                                TextColor="White"
                                                CornerRadius="5"
                                                HeightRequest="30"
                                                WidthRequest="60"
                                                Padding="0"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnEditSupplierClicked"/>
                                        
                                        <Button Text="Delete"
                                                FontSize="12"
                                                BackgroundColor="#F44336"
                                                TextColor="White"
                                                CornerRadius="5"
                                                HeightRequest="30"
                                                WidthRequest="60"
                                                Padding="0"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnDeleteSupplierClicked"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
        
        <!-- Footer/Status Bar -->
        <StackLayout Grid.Row="2" 
                     Orientation="Horizontal" 
                     HorizontalOptions="Center"
                     Margin="0,20,0,10">
            <Label x:Name="TotalItemsLabel" 
                   Text="Total Suppliers: 0" 
                   FontSize="14" 
                   TextColor="#757575"/>
        </StackLayout>
    </Grid>
</ContentPage>