<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockApplication.Views.PaymentEditPage"
             Title="Record Payment">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Header -->
            <Label x:Name="PageTitleLabel" 
                   Text="Record New Payment" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#3F51B5"/>
            
            <!-- Order Selection Section -->
            <Frame Padding="20" 
                   CornerRadius="10" 
                   BorderColor="Transparent" 
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Order Information" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#3F51B5"/>
                    
                    <!-- Order Number -->
                    <VerticalStackLayout>
                        <Label Text="Order Number *" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="OrderNumberEntry" 
                                   Placeholder="Enter order number"
                                   PlaceholderColor="#BDBDBD"
                                   Keyboard="Numeric"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Find Order Button -->
                    <Button Text="Find Order" 
                            BackgroundColor="#3F51B5"
                            TextColor="White"
                            CornerRadius="5"
                            HorizontalOptions="End"
                            x:Name="FindOrderButton"/>
                    
                    <!-- Order Details (visible after finding order) -->
                    <VerticalStackLayout x:Name="OrderDetailsPanel" IsVisible="false">
                        <Border StrokeShape="RoundRectangle 10,10,10,10"
                               BackgroundColor="#F5F5F5"
                               Padding="15,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="10" ColumnSpacing="15">
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="Order Date:" 
                                       FontSize="14"
                                       TextColor="#9E9E9E"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       x:Name="OrderDateLabel"
                                       Text="Not found" 
                                       FontSize="14"
                                       TextColor="#212121"/>
                                
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="Customer:" 
                                       FontSize="14"
                                       TextColor="#9E9E9E"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       x:Name="CustomerLabel"
                                       Text="Not found" 
                                       FontSize="14"
                                       TextColor="#212121"/>
                                
                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="Total:" 
                                       FontSize="14"
                                       TextColor="#9E9E9E"/>
                                <Label Grid.Row="2" Grid.Column="1"
                                       x:Name="OrderTotalLabel"
                                       Text="฿0.00" 
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#4CAF50"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Payment Details Section -->
            <Frame Padding="20" 
                   CornerRadius="10" 
                   BorderColor="Transparent" 
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Label Text="Payment Details" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#3F51B5"/>
                    
                    <!-- Payment Amount -->
                    <VerticalStackLayout>
                        <Label Text="Payment Amount *" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="AmountEntry" 
                                   Placeholder="Enter payment amount"
                                   PlaceholderColor="#BDBDBD"
                                   Keyboard="Numeric"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Payment Method -->
                    <VerticalStackLayout>
                        <Label Text="Payment Method *" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="0" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Picker x:Name="PaymentMethodPicker" 
                                    Title="Select payment method">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Cash</x:String>
                                        <x:String>Credit Card</x:String>
                                        <x:String>Debit Card</x:String>
                                        <x:String>Mobile Payment</x:String>
                                        <x:String>Gift Card</x:String>
                                        <x:String>Other</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Payment Date -->
                    <VerticalStackLayout>
                        <Label Text="Payment Date" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Frame Grid.Column="0"
                                   Padding="5" 
                                   HasShadow="False" 
                                   BorderColor="#E0E0E0"
                                   CornerRadius="5">
                                <DatePicker x:Name="PaymentDatePicker" 
                                           Format="MMM dd, yyyy"/>
                            </Frame>
                            
                            <Frame Grid.Column="1"
                                   Padding="5" 
                                   HasShadow="False" 
                                   BorderColor="#E0E0E0"
                                   CornerRadius="5">
                                <TimePicker x:Name="PaymentTimePicker" 
                                           Format="HH:mm"/>
                            </Frame>
                        </Grid>
                    </VerticalStackLayout>
                    
                    <!-- Points Calculation -->
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Points to Award" 
                                   FontSize="14" 
                                   TextColor="#616161"/>
                            
                            <Button Grid.Column="1"
                                    Text="Calculate"
                                    FontSize="12"
                                    BackgroundColor="#FF9800"
                                    TextColor="White"
                                    CornerRadius="5"
                                    HeightRequest="30"
                                    Padding="10,0"
                                    x:Name="CalculatePointsButton"/>
                        </Grid>
                        
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="PointsEntry" 
                                   Placeholder="Points earned"
                                   PlaceholderColor="#BDBDBD"
                                   Keyboard="Numeric"
                                   Text="0"/>
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Grid.Column="0"
                        Text="Cancel"
                        BackgroundColor="#E0E0E0"
                        TextColor="#616161"
                        CornerRadius="10"
                        x:Name="CancelButton"/>
                
                <Button Grid.Column="1"
                        Text="Save Payment"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="10"
                        x:Name="SaveButton"/>
            </Grid>
            
            <!-- Required Fields Note -->
            <Label Text="* Required fields" 
                   FontSize="12" 
                   TextColor="#9E9E9E"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>