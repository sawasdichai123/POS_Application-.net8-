<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockApplication.Views.MenuItemEditPage"
             Title="Edit Menu Item">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Header -->
            <Label x:Name="PageTitleLabel" 
                   Text="Add New Menu Item" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#3F51B5"/>
            
            <!-- Form Section -->
            <Frame Padding="20" 
                   CornerRadius="10" 
                   BorderColor="Transparent" 
                   HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <!-- Item Name -->
                    <VerticalStackLayout>
                        <Label Text="Item Name *" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="MenuNameEntry" 
                                   Placeholder="Enter menu item name"
                                   PlaceholderColor="#BDBDBD"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Category -->
                    <VerticalStackLayout>
                        <Label Text="Category *" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="0" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Picker x:Name="CategoryPicker" 
                                    Title="Select category">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Main</x:String>
                                        <x:String>Side</x:String>
                                        <x:String>Dessert</x:String>
                                        <x:String>Beverage</x:String>
                                        <x:String>Other</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Price -->
                    <VerticalStackLayout>
                        <Label Text="Price *" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Entry x:Name="PriceEntry" 
                                   Placeholder="Enter price"
                                   PlaceholderColor="#BDBDBD"
                                   Keyboard="Numeric"/>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!-- Description -->
                    <VerticalStackLayout>
                        <Label Text="Description" 
                               FontSize="14" 
                               TextColor="#616161"/>
                        <Frame Padding="5" 
                               HasShadow="False" 
                               BorderColor="#E0E0E0"
                               CornerRadius="5">
                            <Editor x:Name="DescriptionEditor" 
                                   Placeholder="Enter item description"
                                   PlaceholderColor="#BDBDBD"
                                   HeightRequest="100"
                                   AutoSize="TextChanges"/>
                        </Frame>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>
            
            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Grid.Column="0"
                        Text="Cancel"
                        BackgroundColor="#E0E0E0"
                        TextColor="#616161"
                        CornerRadius="10"
                        x:Name="CancelButton"/>
                
                <Button Grid.Column="1"
                        Text="Save"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        CornerRadius="10"
                        x:Name="SaveButton"/>
            </Grid>
            
            <!-- Required Fields Note -->
            <Label Text="* Required fields" 
                   FontSize="12" 
                   TextColor="#9E9E9E"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>