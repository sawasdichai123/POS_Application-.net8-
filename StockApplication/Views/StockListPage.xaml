<?xml version="1.0" encoding="utf-8" ?>
<!-- StockListPage.xaml -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockApplication.Views.StockListPage"
             
             Title="Stock Inventory">
    
    <Grid RowDefinitions="Auto,*,Auto" Padding="15">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,10,0,20">
            <VerticalStackLayout Grid.Column="0">
                <Label Text="Stock Inventory" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       TextColor="#3F51B5"/>
                <Label Text="Manage your inventory items" 
                       FontSize="14" 
                       TextColor="#757575"
                       Margin="0,5,0,0"/>
            </VerticalStackLayout>
            
            <Button Grid.Column="1"
                    Text="+ Add Stock"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="40"
                    VerticalOptions="Center"
                    x:Name="AddStockButton"/>
        </Grid>
        
        <!-- Search and Filter Bar -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                <Frame Grid.Column="0"
                       Padding="15,0"
                       CornerRadius="10"
                       BorderColor="#E0E0E0"
                       HasShadow="False">
                    <Entry Placeholder="Search stock items..."
                           PlaceholderColor="#9E9E9E"
                           x:Name="SearchEntry"
                           VerticalOptions="Center"
                           ClearButtonVisibility="WhileEditing"/>
                </Frame>
                
                <Button Grid.Column="1"
                        Text="Filter"
                        BackgroundColor="#3F51B5"
                        TextColor="White"
                        CornerRadius="10"
                        Margin="10,0,0,0"
                        WidthRequest="80"
                        x:Name="FilterButton"/>
            </Grid>
            
            <!-- Stock List -->
            <RefreshView Grid.Row="1" x:Name="StockRefreshView">
                <CollectionView x:Name="StockCollectionView"
                               SelectionMode="Single">
                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="empty_box.png" 
                                   HeightRequest="100" 
                                   WidthRequest="100"
                                   Opacity="0.5"
                                   Margin="0,0,0,20"/>
                            <Label Text="No stock items found" 
                                   FontSize="18" 
                                   TextColor="#9E9E9E"
                                   HorizontalOptions="Center"/>
                            <Label Text="Add your first stock item to get started" 
                                   FontSize="14" 
                                   TextColor="#BDBDBD"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                    
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,5,0,10"
                                   Padding="15"
                                   CornerRadius="10"
                                   BorderColor="Transparent"
                                   HasShadow="True">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                    <!-- Stock Name and Type -->
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                        <Label Text="{Binding Stock_Name}" 
                                               FontSize="18" 
                                               FontAttributes="Bold"
                                               TextColor="#212121"/>
                                        <Label Text="{Binding Type}" 
                                               FontSize="14"
                                               TextColor="#757575"/>
                                    </VerticalStackLayout>
                                    
                                    <!-- Quantity -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                           Stroke="#E0E0E0"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 10,10,10,10"
                                           BackgroundColor="#F5F5F5"
                                           Padding="10,5"
                                           VerticalOptions="Center">
                                        <VerticalStackLayout HorizontalOptions="Center">
                                            <Label Text="{Binding Quantity, StringFormat='{0:F1}'}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold"
                                                   TextColor="#3F51B5"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="{Binding Unit}" 
                                                   FontSize="12"
                                                   TextColor="#9E9E9E"
                                                   HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    
                                    <!-- Divider -->
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="2"
                                            Color="#E0E0E0"
                                            HeightRequest="1"
                                            Margin="0,10"/>
                                    
                                    <!-- Footer Info -->
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*,Auto">
                                        <!-- Supplier -->
                                        <VerticalStackLayout Grid.Column="0">
                                            <Label Text="Supplier" 
                                                   FontSize="12"
                                                   TextColor="#9E9E9E"/>
                                            <Label Text="{Binding SupplierName}" 
                                                   FontSize="14"
                                                   TextColor="#616161"/>
                                        </VerticalStackLayout>
                                        
                                        <!-- Expiry Date -->
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="Expires On" 
                                                   FontSize="12"
                                                   TextColor="#9E9E9E"/>
                                            <Label Text="{Binding ExpiryDate, StringFormat='{0:MM/dd/yyyy}'}" 
                                                   FontSize="14"
                                                   TextColor="#616161"/>
                                        </VerticalStackLayout>
                                        
                                        <!-- Actions -->
                                        <HorizontalStackLayout Grid.Column="2" Spacing="10">
                                            <Button Text="Edit"
                                                    FontSize="12"
                                                    BackgroundColor="#2196F3"
                                                    TextColor="White"
                                                    CornerRadius="5"
                                                    HeightRequest="30"
                                                    WidthRequest="60"
                                                    Padding="0"
                                                    Clicked="OnEditButtonClicked"
                                                    CommandParameter="{Binding .}"/>
                                            
                                            <Button Text="Delete"
                                                    FontSize="12"
                                                    BackgroundColor="#F44336"
                                                    TextColor="White"
                                                    CornerRadius="5"
                                                    HeightRequest="30"
                                                    WidthRequest="60"
                                                    Padding="0"
                                                    Clicked="OnDeleteButtonClicked"
                                                    CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
        
        <!-- Footer/Status Bar -->
        <StackLayout Grid.Row="2" 
                     Orientation="Horizontal" 
                     HorizontalOptions="Center"
                     Margin="0,20,0,10">
            <Label x:Name="TotalItemsLabel" 
                   Text="Total Items: 0" 
                   FontSize="14" 
                   TextColor="#757575"/>
        </StackLayout>
    </Grid>
</ContentPage>