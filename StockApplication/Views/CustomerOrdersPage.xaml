<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StockApplication.Views.CustomerOrdersPage"
             Title="Customer Orders">
    
    <Grid RowDefinitions="Auto,*,Auto" Padding="15">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Margin="0,10,0,20">
            <Label x:Name="CustomerNameLabel"
                   Text="Customer Name" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#3F51B5"/>
            <Grid ColumnDefinitions="*,*">
                <Label Grid.Column="0"
                       Text="Order History" 
                       FontSize="14" 
                       TextColor="#757575"/>
                <Label Grid.Column="1"
                       x:Name="CustomerPointsLabel"
                       Text="Points: 0" 
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#FF6F00"
                       HorizontalOptions="End"/>
            </Grid>
        </VerticalStackLayout>
        
        <!-- Orders List -->
        <RefreshView Grid.Row="1" x:Name="OrdersRefreshView">
            <CollectionView x:Name="CustomerOrdersCollection">
                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="empty_order.png" 
                               HeightRequest="100" 
                               WidthRequest="100"
                               Opacity="0.5"
                               Margin="0,0,0,20"/>
                        <Label Text="No orders found" 
                               FontSize="18" 
                               TextColor="#9E9E9E"
                               HorizontalOptions="Center"/>
                        <Label Text="This customer hasn't placed any orders yet" 
                               FontSize="14" 
                               TextColor="#BDBDBD"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </CollectionView.EmptyView>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5,0,10"
                               Padding="15"
                               CornerRadius="10"
                               BorderColor="Transparent"
                               HasShadow="True">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <!-- Order ID and Date -->
                                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0"
                                           Text="{Binding OrderID, StringFormat='Order #{0}'}" 
                                           FontSize="18" 
                                           FontAttributes="Bold"
                                           TextColor="#212121"/>
                                    
                                    <Label Grid.Column="1"
                                           Text="{Binding OrderDate, StringFormat='{0:MM/dd/yyyy}'}" 
                                           FontSize="14"
                                           TextColor="#757575"
                                           HorizontalOptions="End"/>
                                </Grid>
                                
                                <!-- Amount and Status -->
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                                   Margin="0,10,0,10">
                                    <Label Text="{Binding TotalAmount, StringFormat='Total: ฿{0:F2}'}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#3F51B5"/>
                                </VerticalStackLayout>
                                
                                <!-- Status Badge -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                       Stroke="#E0E0E0"
                                       StrokeThickness="1"
                                       StrokeShape="RoundRectangle 10,10,10,10"
                                       BackgroundColor="{Binding StatusColor}"
                                       Padding="10,5"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding PaymentStatus}"
                                           TextColor="White"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                </Border>
                                
                                <!-- Divider -->
                                <BoxView Grid.Row="2" Grid.ColumnSpan="2"
                                        Color="#E0E0E0"
                                        HeightRequest="1"
                                        Margin="0,5,0,10"/>
                                
                                <!-- Action Buttons -->
                                <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2"
                                                     Spacing="10"
                                                     HorizontalOptions="End">
                                    <Button Text="View Details"
                                            FontSize="12"
                                            BackgroundColor="#FF9800"
                                            TextColor="White"
                                            CornerRadius="5"
                                            HeightRequest="30"
                                            WidthRequest="100"
                                            Padding="0"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnViewOrderDetailsClicked"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
        <!-- Footer Buttons -->
        <Grid Grid.Row="2" 
              ColumnDefinitions="*,*" 
              ColumnSpacing="15"
              Margin="0,15,0,0">
            <Button Grid.Column="0"
                    Text="Back to Customers"
                    BackgroundColor="#E0E0E0"
                    TextColor="#616161"
                    CornerRadius="10"
                    x:Name="BackButton"/>
            
            <Button Grid.Column="1"
                    Text="New Order"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    x:Name="NewOrderButton"/>
        </Grid>
    </Grid>
</ContentPage>